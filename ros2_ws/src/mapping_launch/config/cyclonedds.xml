<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for the dual-robot P6 system.

  Topology: rover laptop (192.168.0.205) <-> drone Pi (192.168.0.202) over wifi.

  Goals:
    * No multicast. Wifi APs frequently drop or rate-limit multicast, which
      breaks SPDP discovery and reliable retransmissions. Discovery falls
      back to unicast SPDP via the explicit <Peers> list.
    * Large UDP socket buffers so 10 Hz pointclouds (~50 KB each plus IMU)
      don't drop bursts at the kernel boundary.
    * Both machines share this file via the mapping_launch package share
      dir, loaded through CYCLONEDDS_URI in the launch files.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <!-- Interface is pinned per-host via a chained CYCLONEDDS_URI override
           (~/cyclone_iface.xml on each box). Don't put <Interfaces> here:
           autodetermine on multi-NIC hosts picks the wrong subnet and
           SPDP/data unicast goes out with a source IP the peer can't
           reverse-route, so rp_filter silently drops it. -->
      <AllowMulticast>false</AllowMulticast>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.205"/>  <!-- rover laptop -->
        <Peer address="192.168.0.202"/>  <!-- drone Pi -->
        <Peer address="192.168.0.201"/>  <!-- leorover Pi -->
        <Peer address="192.168.0.210"/>  <!-- laptop for rviz -->
      </Peers>
    </Discovery>

    <Internal>
      <SocketReceiveBufferSize min="2MB"/>
      <SocketSendBufferSize min="2MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
