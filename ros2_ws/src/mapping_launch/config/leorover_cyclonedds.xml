<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration:
  This file is for the Leorover Pi set to static IP 192.168.0.201.
  It defines the interface address so autodectection doesn't pick the wrong one.
  It defines peer list of who it can talk to using unicast.
  If you get an error saying 2MB buffer size is not allowed, increase the max buffer size on the host with:
    sudo sysctl -w net.core.rmem_max=8388608
    sudo sysctl -w net.core.wmem_max=8388608
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <Interfaces>
         <NetworkInterface address="192.168.0.201" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.205"/>  <!-- rover laptop -->
        <Peer address="192.168.0.202"/>  <!-- drone Pi -->
        <Peer address="192.168.0.201"/>  <!-- leorover Pi -->
        <Peer address="192.168.0.210"/>  <!-- laptop for rviz -->
      </Peers>
    </Discovery>

    <Internal>
      <SocketReceiveBufferSize min="2MB"/>
      <SocketSendBufferSize min="2MB"/>
    </Internal>
  </Domain>
</CycloneDDS>