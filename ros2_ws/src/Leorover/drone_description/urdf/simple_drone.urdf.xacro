<?xml version="1.0"?>

<robot name="simple_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mass" value="1.0"/>

  <!-- Base link -->
  <link name="base_link">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.04"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.3 0.3 0.05"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.3 0.3 0.05"/>
      </geometry>
    </collision>
  </link>

</robot>